# Aegis Configuration — Team & Workflow Configuration
# Copy this file to aegis.conf and customize for your environment.
# If no aegis.conf exists, all defaults apply (solo developer, trunk-based).

# ─── Platform ─────────────────────────────────────────────────────

# AEGIS_PLATFORM: gemini | kiro | copilot | claude | mcp
# Determines which installer runs on `make install`
# Namespaced to avoid collision with Docker/CI PLATFORM env var.
AEGIS_PLATFORM=gemini

# Default review mode (set by Genesis Lichen or manually).
# Modes: breeze | gale | trident | maelstrom | tempest
# DEFAULT_REVIEW_MODE=gale

# Minimum review mode floor (cannot go below this).
# MINIMUM_REVIEW_MODE=breeze

# ─── Team Structure ───────────────────────────────────────────────

# TEAM_SIZE: solo | small (2-5) | team (6-20) | enterprise (20+)
# Affects: branching strategy, approval requirements, PR policies
TEAM_SIZE=solo

# APPROVAL_CHAIN: none | peer | lead
# Who must approve destructive operations and architectural changes?
APPROVAL_CHAIN=none

# ─── Git Workflow ─────────────────────────────────────────────────

# GIT_STRATEGY: trunk | feature-branch | gitflow
#   trunk          = direct commits to main (default for solo)
#   feature-branch = all changes via feature/<name> branches
#   gitflow        = develop/release/hotfix branching model
GIT_STRATEGY=trunk

# ─── Installation ─────────────────────────────────────────────────

# RULES_SUBSET: all | core | minimal
#   all     = full 11-rule suite (~4,380 tokens idle, 3,743 always-on, measured via token_census.py)
#   core    = 6 rules: providence, cost-optimization, subagent-delegation, testing, git-workflow, destructive-ops
#   minimal = 3 rules: providence, subagent-delegation, destructive-ops
RULES_SUBSET=all

# ENABLE_HOOKS: true | false
# Deploy lifecycle hooks (immune monitor, safety gate, session close).
# Set false if your platform doesn't support lifecycle hooks.
ENABLE_HOOKS=true

# ─── Context Budget & JIT Delivery ──────────────────────────────

# MAX_JIT_TOKENS: maximum token ceiling for JIT context expression (default: 2000).
# Strictly bounds prompt overhead injected into AI agent context windows.
# Can also be set via AEGIS_MAX_JIT_TOKENS environment variable.
MAX_JIT_TOKENS=2000

# ─── Data & Metrics ──────────────────────────────────────────────

# METRICS_REPO: path to a separate (private) repo for metrics snapshots
# If unset, snapshots are stored in docs/snapshots/ within this repo.
# Set this to keep telemetry data separate from the public governance repo.
# The directory will be created if it doesn't exist.
# METRICS_REPO=~/repos/soma-telemetry

# CONVERSATION_LOG_DIR: path where AI assistant conversation logs live
# Note: This is not yet consumed by scripts.
# Default: ~/.gemini/antigravity/brain (Antigravity/AGY)
# CONVERSATION_LOG_DIR=~/.gemini/antigravity/brain

# GENESIS_REPORT_DIR: where Genesis reports are stored and loaded from
# Note: This is not yet consumed by scripts.
# Default: docs/ (within this repo)
# GENESIS_REPORT_DIR=docs/

# ─── Team Shared Repo ────────────────────────────────────────────

# TEAM_REPO: path to a shared git repo where team governance converges.
# Promoted cells, shared metrics, and Genesis reports live here.
# All team members point to the same repo.
# If unset, the system operates in solo mode (all local).
# Supersedes METRICS_REPO when set.
# TEAM_REPO=~/repos/soma-team

# TEAM_MEMBER_ID: identifier for this team member (no PII — use initials or alias).
# Used to namespace metrics snapshots so they don't collide.
# TEAM_MEMBER_ID=ns

# ─── Organization Repo (Multi-Team) ──────────────────────────────

# ORG_REPO: upstream org-level repo for multi-team organizations (optional).
# If set, team_sync.sh also pushes/pulls from the org level.
# Hierarchy: Individual → TEAM_REPO → ORG_REPO
# ORG_REPO=~/repos/soma-org

# ─── Data & Metrics ───────────────────────────────────────────────

# CELL_TELOMERE_DAYS: number of days for fitness confidence to halve.
# Cells that stop being triggered decay naturally. Default: 30.
# Set higher for slow-moving projects, lower for fast iteration.
# CELL_TELOMERE_DAYS=30
# Per-type telomere shortening overrides (optional).
# Set to 'null' for types that should never decay (e.g., mathematical invariants).
# CELL_TELOMERE_WALL=null
# CELL_TELOMERE_VACUOLE=30
# CELL_TELOMERE_CHLOROPLAST=60
# CELL_TELOMERE_MEMBRANE=45
# CELL_TELOMERE_PLASMODESMATA=60

# STOCHASTIC_GENESIS_INTERVAL: Number of sessions between random cell injections.
# Injects random diversity (Cambrian Trigger) to prevent local optima. Default: 10.
# STOCHASTIC_GENESIS_INTERVAL=10

# ─── Inference Provider ──────────────────────────────────────────

# AEGIS_INFERENCE_PROVIDER: auto | gemini | anthropic | openai | prompt-only
# Controls which LLM provider is used for AI-assisted features (NL cell creation).
# 'auto' tries providers in order: Gemini → Anthropic → OpenAI → prompt-only.
# When running as an MCP server, the host agent IS the provider — no key needed.
# AEGIS_INFERENCE_PROVIDER=auto

# API keys — only needed when running standalone CLI, not with MCP.
# Must be set via environment variables (e.g., GEMINI_API_KEY) or system keyring.
# OPENAI_BASE_URL=          # For OpenAI-compatible endpoints (e.g., local LLMs)
