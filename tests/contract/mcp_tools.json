{
  "tools": [
    {
      "name": "aegis_scan",
      "description": "Call before editing files: returns the governance rules that apply to them, ranked and clamped to the JIT token budget.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "Scan JIT Rules"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Workspace-relative files you are about to edit. Defaults to the git diff."
          },
          "view": {
            "type": "string",
            "enum": [
              "full",
              "summary",
              "ids"
            ],
            "description": "Optional response projection: full (default), summary or ids."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "aegis_report_outcome",
      "description": "Report whether the rules you were shown helped. Each report is an advisory self-report row in the outcome ledger; it never promotes a rule by itself.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "Report Outcome"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "failure",
              "tp",
              "fp",
              "pass",
              "fail"
            ],
            "description": "Verification outcome."
          },
          "idempotency_key": {
            "type": "string",
            "description": "Unique key for this report. Retrying with the same key never records twice."
          },
          "rules_used": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of the rules this outcome is about."
          },
          "tests_passed": {
            "type": "boolean"
          },
          "rework_count": {
            "type": "integer",
            "default": 0
          },
          "notes": {
            "type": "string"
          },
          "view": {
            "type": "string",
            "enum": [
              "full",
              "summary",
              "ids"
            ],
            "description": "Optional response projection: full (default), summary or ids."
          }
        },
        "required": [
          "outcome",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aegis_create_rule",
      "description": "Turn a natural language concern into a prompt that drafts a governance rule. It writes nothing: save the drafted rule under .aegis/rules/ yourself.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "Create Rule"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "The concern, in natural language."
          },
          "rule_type": {
            "type": "string",
            "enum": [
              "invariant",
              "trap",
              "gate",
              "boundary",
              "persona",
              "contract"
            ],
            "description": "Optional rule type hint."
          },
          "domain": {
            "type": "string",
            "description": "Optional domain hint."
          }
        },
        "required": [
          "description"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "aegis_list_rules",
      "description": "List the governance rules with their type, hypothesis and ledger fitness.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "title": "List Rules"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "rule_type": {
            "type": "string",
            "enum": [
              "invariant",
              "trap",
              "gate",
              "boundary",
              "persona",
              "contract"
            ],
            "description": "Optional rule type filter."
          },
          "view": {
            "type": "string",
            "enum": [
              "full",
              "summary",
              "ids"
            ],
            "description": "Optional response projection: full (default), summary or ids."
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
